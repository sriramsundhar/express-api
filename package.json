{
  "name": "@sriramsundhar/express-api",
  "version": "1.0.2",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/sriramsundhar/express-api.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "src/app.ts",
  "scripts": {
    "assert:version": "(node --version | grep -q ^v22) || (echo 'You must be using Node v22' && false)",
    "build": "tsc",
    "build:watch": "npm run build -- --watch",
    "bundle": "tsc",
    "test": "cucumber-js --config test/cucumber.js",
    "format": "prettier --write \"./**/*.ts\"",
    "format:ci": "prettier --check \"./**/*.ts\"",
    "lint": "eslint --max-warnings 0 ./src",
    "lint:fix": "npm run lint -- --fix",
    "prebuild": "npm run assert:version && npm run tspCompile",
    "postbuild": "cp -r ./src/@typespec dist/src/@typespec",
    "prestart:dev": "npm run assert:version",
    "quickDev": "concurrently npm:build:watch npm:start:dev",
    "start": "nodemon --watch ./dist --exec node ./dist/src/app.js",
    "start:dev": "NODE_ENV=dev npm run start",
    "tspCompile": "tsp compile ./swagger"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@eslint/js": "^9.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tsconfig/recommended": "^1.0.8",
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "globals": "^15.8.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "semantic-release": "^24.0.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.17.0"
  },
  "dependencies": {
    "@types/yamljs": "^0.2.34",
    "@typespec/compiler": "^1.10.0",
    "@typespec/http": "^1.10.0",
    "@typespec/openapi3": "^1.10.0",
    "axios": "^1.8.2",
    "body-parser": "^1.20.2",
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "mongoose": "^8.5.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.1",
    "yamljs": "^0.3.0"
  }
}